{
  "name": "let-it-snow",
  "version": "2.0.6",
  "description": "A magical snowfall extension for web pages",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:playground": "cross-env PLAYGROUND=true vite",
    "build": "node scripts/build.js",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build:edge": "vite build --mode edge",
    "preview": "vite preview",
    "test": "vitest run",
    "sync-version": "node scripts/sync-version.js",
    "version": "pnpm run sync-version",
    "pack:chrome": "crx3 dist/chrome -o builds/let-it-snow-chrome.crx",
    "pack:chrome:zip": "cd dist/chrome && zip -r ../../builds/let-it-snow-chrome.zip . && cd ../../",
    "pack:firefox": "cd dist/firefox && zip -r ../../builds/let-it-snow-firefox.zip . && cd ../../",
    "pack:edge": "crx3 dist/edge -o builds/let-it-snow-edge.crx",
    "playground": "node scripts/playground-server.js",
    "update-deps": "ncu -u && pnpm install",
    "check-updates": "ncu"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "crx3": "^2.0.0",
    "jsdom": "^30.1.3",
    "npm-check-updates": "^23.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
